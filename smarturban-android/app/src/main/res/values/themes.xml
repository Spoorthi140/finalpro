<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.SmartUrban" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">#0284C7</item>
        <item name="colorPrimaryVariant">#0369A1</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <!-- Secondary brand colors -->
        <item name="colorSecondary">#0D9488</item>
        <item name="colorSecondaryVariant">#0F766E</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Text and Input Default Colors for Light Backgrounds -->
        <item name="android:textColorPrimary">#0F172A</item>
        <item name="android:textColorSecondary">#475569</item>
        <item name="android:textColorHint">#64748B</item>
        <item name="android:editTextColor">#0F172A</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Theme for SplashActivity without ActionBar -->
    <style name="Theme.SmartUrban.NoActionBar" parent="Theme.SmartUrban">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">#1E293B</item>
    </style>
</resources>
