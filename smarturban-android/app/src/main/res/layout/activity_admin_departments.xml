<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Department Management"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/et_dept_name"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:hint="New Department Name"
            android:paddingHorizontal="12dp"
            android:background="#F1F5F9" />

        <EditText
            android:id="@+id/et_dept_desc"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:hint="Description"
            android:paddingHorizontal="12dp"
            android:background="#F1F5F9" />

        <Button
            android:id="@+id/btn_add_department"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="Add Department"
            android:backgroundTint="#8B5CF6" />
    </LinearLayout>

    <ListView
        android:id="@+id/lv_admin_departments"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp" />

</LinearLayout>
